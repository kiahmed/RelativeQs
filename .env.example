# Frontend (Vite) environment variables.
# Only variables prefixed with VITE_ are exposed to the app.
# Vite inlines these at build time — restart `npm run dev` / rebuild after changes.

# Base URL of the backend HTTP API.
# 8001 is the port docker-compose publishes (container listens on 8000, mapped
# 8001:8000). Running uvicorn natively instead? Use 8000 in both URLs below.
VITE_RELQS_BACKEND_URL=http://localhost:8001

# Websocket URL for the realtime feed (leave blank to derive from VITE_RELQS_BACKEND_URL).
VITE_RELQS_WS_URL=ws://localhost:8001/ws/market

# How often the dashboard re-fetches data over HTTP, in milliseconds.
VITE_POLL_INTERVAL_MS=12000

# Supabase Auth — from your Supabase project dashboard (Settings -> API).
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-public-key
