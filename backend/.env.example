# Example environment variables for the backend
# Set DATA_PROVIDER to one of: mock, yahoo, alphavantage, twelvedata, polygon, alpaca, finnhub
DATA_PROVIDER=yahoo

# API keys (leave blank to disable an adapter)
ALPHAVANTAGE_KEY=
TWELVEDATA_KEY=
POLYGON_KEY=
ALPACA_KEY=
ALPACA_SECRET=
FINNHUB_KEY=

# Redis (optional) - if set, snapshots will be published to Redis pub/sub and persisted.
# For managed Upstash: paste the rediss:// URL from the dashboard AS-IS, no
# surrounding quotes. Docker Compose's env_file passes values through literally
# (unlike a shell), so a quoted "rediss://..." becomes the literal string
# including the quote characters and redis.from_url() rejects it as schemeless.
REDIS_URL=redis://127.0.0.1:6379/0
# Redis only holds the per-day 1-minute bar history (key bars:<ET date>, ~7 days);
# the latest snapshot/prediction/rotation payloads and the price cache live in the
# backend's memory. Writes are throttled so a free managed plan lasts: Upstash free
# = 500K commands + 10 GB bandwidth per month (this uses roughly 10K commands and
# 1-2 GB a month). Don't set a higher write rate without checking that budget.
# Key prefixes persisted to Redis (comma-separated), and min seconds between writes
# of the same key:
REDIS_PERSIST_PREFIXES=bars:
REDIS_FLUSH_SECONDS=300

# If true, the ScoreEngine will compute z-score normalized signals when requested
NORMALIZE_SIGNALS=false

# Logging verbosity: DEBUG, INFO, WARNING, ERROR. Logs go to the console and to
# backend/logs/app.log (rotating). DEBUG is very chatty.
LOG_LEVEL=INFO

# --- Update / refresh rates -------------------------------------------------
# How often the backend re-fetches data and broadcasts it (seconds).
POLL_INTERVAL_SECONDS=30
# How long fetched price history is cached before the provider is called again (seconds).
CACHE_TTL_SECONDS=300
# Also fetch pre-market / after-hours bars whenever the regular session (09:30-16:00
# ET, weekdays) is closed, so data stays visible until the next open.
FETCH_PRE_POST_MARKET=true
# Never hit the Yahoo download path more often than this (seconds) — rate-limit guard.
YAHOO_MIN_FETCH_INTERVAL_SECONDS=60

# --- Intraday history store & backfill --------------------------------------
# Calendar days of 1-minute bars kept in Redis (7 = Yahoo's 1m history cap).
HISTORY_RETENTION_DAYS=7
# On a cold cache, seed Redis from a provider so cross-day signals (stability,
# hit-rate) work on day one instead of waiting for days of self-collected bars.
HISTORY_BACKFILL_ENABLED=true
# Where backfill comes from: provider (= DATA_PROVIDER), yahoo, or none.
HISTORY_BACKFILL_SOURCE=provider
# Days of 1m history to pull when seeding, and the cached-session count above which
# no backfill is done.
HISTORY_BACKFILL_DAYS=7
HISTORY_BACKFILL_MIN_SESSIONS=5

# --- Per-provider rate limits (max API calls per 60 seconds) ----------------
TWELVEDATA_RATE_LIMIT=8
ALPHAVANTAGE_RATE_LIMIT=5
POLYGON_RATE_LIMIT=5
FINNHUB_RATE_LIMIT=30
ALPACA_RATE_LIMIT=5

# --- Supabase Auth ----------------------------------------------------------
# From your Supabase project dashboard -> Settings -> API.
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# Only needed for LEGACY (HS256) projects. Projects using asymmetric JWT
# signing keys are verified via JWKS automatically — leave this as-is then.
SUPABASE_JWT_SECRET=your-supabase-jwt-secret
# SECRET — server only, never a VITE_ variable, never committed. Needed to write the
# billing plan, read alert recipients and save the daily captures (RLS blocks the
# anon key). Newer dashboard: Project Settings -> API Keys -> "Legacy anon,
# service_role API keys" tab -> service_role (a long eyJ... string). One line only;
# a leftover duplicate SUPABASE_SERVICE_KEY= line makes it unclear which one wins.
SUPABASE_SERVICE_KEY=your-supabase-service-role-key

# --- Stripe billing ---------------------------------------------------------
# Stripe dashboard -> Developers -> API keys -> Secret key (use a sk_test_ key).
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
# Webhook signing secret. Local dev: run `stripe listen --forward-to
# localhost:8000/api/billing/webhook` and copy the whsec_... it prints.
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_signing_secret
# The recurring Price ID of your "RelativeQs Pro" product (price_...).
STRIPE_PRICE_ID=price_your_pro_price_id
# Frontend base URL Stripe Checkout redirects back to (5173 dev / 4173 preview).
FRONTEND_URL=http://localhost:5173

# --- CORS (production) ------------------------------------------------------
# Comma-separated list of extra allowed origins for the deployed frontend.
# localhost dev origins are always allowed; add the Vercel site here.
# e.g. CORS_ORIGINS=https://<frontend>.vercel.app
CORS_ORIGINS=

# --- Alerts (Resend email) --------------------------------------------------
# API key from resend.com (re_...). If left blank, alerts are logged, not sent.
RESEND_API_KEY=re_your_resend_api_key
# Sender address. Use onboarding@resend.dev for testing, a verified domain live.
ALERT_FROM_EMAIL=RelativeQs <onboarding@resend.dev>

# --- Prediction engine (intraday, 1-minute bars) -----------------------------
# Tracked universe; the target (QQQ) must be in it. Edit to change what is measured.
ETF_UNIVERSE=QQQ,XLK,SMH,MAGS,IGV,XLY,XLF,XLI,IWM,XLE,XLP,TLT
# The index being predicted.
PREDICTION_TARGET=QQQ
# Lead/lag: cross-correlation scan range (minutes), bars needed before a verdict
# (before that the status is "warming_up"), the correlation a symbol needs to count
# as leader/confirmer, and how many consecutive new bars a lead must recur on before
# it is promoted to a confirmed leader.
LEAD_LAG_MAX_LAG=15
LEAD_LAG_MIN_BARS=45
LEAD_LAG_CORR_THRESHOLD=0.25
LEAD_LAG_STREAK_MIN=3
# Projection horizon (minutes).
PROJECTION_HORIZON_MINUTES=15
# Driver attribution: the "engines under QQQ" (subset of ETF_UNIVERSE) and window (1m bars).
DRIVER_SYMBOLS=SMH,IGV,MAGS
ATTRIBUTION_WINDOW=30
# Correlation regime: trailing window (bars) and the thresholds that separate
# coupled / transitional / fragmented.
CORR_REGIME_WINDOW=30
CORR_COUPLED_THRESHOLD=0.6
CORR_FRAGMENTED_THRESHOLD=0.3
# Cross-day stability of the leader: sessions looked back over, minimum sessions
# needed, allowed lag drift (minutes), and the persistence that counts as tradeable.
STABILITY_LOOKBACK_DAYS=5
STABILITY_MIN_SESSIONS=2
STABILITY_LAG_TOLERANCE=2
STABILITY_TRADEABLE_PERSISTENCE=0.6
# Leader hit-rate: minimum samples before a rate is shown, and the fixed horizons
# (minutes) offered in the dashboard.
HITRATE_MIN_SAMPLE=30
HITRATE_HORIZONS=5,15,30
# Nasdaq-100 breadth (how many of QQQ's ~100 stocks are advancing).
BREADTH_ENABLED=true
BREADTH_TARGET=QQQ

# --- AI-capex dependency index (structural / daily — NOT intraday) ----------
# How much of QQQ's DAILY move is explained by the "AI bottleneck" complex
# (memory, optics/EUV, networking, power, grid). Daily metric, walled off from
# the intraday thesis; cached in-process and refetched every
# AI_DEPENDENCY_REFRESH_SECONDS.
AI_DEPENDENCY_ENABLED=true
AI_DEPENDENCY_TARGET=QQQ
AI_DEPENDENCY_WINDOW=21
# Minimum daily returns inside a window before its value is emitted (else a gap).
AI_DEPENDENCY_MIN_OBS=10
AI_DEPENDENCY_CHANGE_LOOKBACK=21
AI_DEPENDENCY_PERIOD=2y
AI_DEPENDENCY_REFRESH_SECONDS=3600
# The basket, grouped by theme. JSON list of {key,label,members:[{symbol,label}]}.
# Members can be pure-play ETFs, dominant bellwether stocks, or standalone names
# with no ETF home yet. Edit freely. Unset/invalid -> config.py _ai_basket() default.
AI_BASKET='[{"key":"memory","label":"Memory","members":[{"symbol":"DRAM","label":"Memory ETF"},{"symbol":"MU","label":"Micron"}]},{"key":"optics","label":"Optics / EUV","members":[{"symbol":"EUV","label":"EUV/optics ETF"},{"symbol":"ASML","label":"ASML"}]},{"key":"networking","label":"Servers / Networking","members":[{"symbol":"TCAI","label":"AI infra ETF"}]},{"key":"power","label":"Power","members":[{"symbol":"AIPO","label":"AI power ETF"},{"symbol":"ZAP","label":"Electrification ETF"}]},{"key":"grid","label":"Grid build-out","members":[{"symbol":"GRID","label":"Smart-grid ETF"}]}]'

# --- Overnight / pre-market board -------------------------------------------
PREMARKET_ENABLED=true
# How many top movers to show, and the smallest overnight gap (fraction, 0.01 = 1%)
# that counts as a move rather than noise.
PREMARKET_TOP_N=8
PREMARKET_MIN_GAP=0.01
# Refresh cadence (seconds). The board pulls ~100 tickers, so ~15 min is plenty.
PREMARKET_REFRESH_SECONDS=900
# Overnight tape baskets (markets closed before the US open): Asia semis, Europe tech.
PREMARKET_ASIA_BASKET=2330.TW,005930.KS,000660.KS,8035.T,6857.T
PREMARKET_EUROPE=ASML.AS
# Dev only: ribbon never auto-collapses off-hours (default false)
PREMARKET_FORCE_OPEN=false

# Bearer token securing the WHOLE backend for server-to-server callers (e.g.
# EdgeLane): every /api route (except /api/health + the Stripe webhook) and
# /ws/market accept `Authorization: Bearer <this>` (websocket: ?token=<this>)
# OR a Supabase session token. Unset = service access off, JWT only.
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(32))"
RELQ_API_TOKEN=

# --- Daily persistence (Supabase) -------------------------------------------
# Saves the overnight movers (09:28 ET) and a daily highlights row (10:05 ET) to
# the overnight_movers_stats / daily_highlights tables, joined on trade_date.
# Needs SUPABASE_URL + SUPABASE_SERVICE_KEY and supabase/migrations/0003 applied.
DAILY_CAPTURE_ENABLED=true
OVERNIGHT_CAPTURE_TIME=09:28
HIGHLIGHTS_CAPTURE_TIME=10:05

# --- API docs --------------------------------------------------------------
# /docs, /redoc and /openapi.json list every route (gated ones included), so they
# are OFF by default. Set to true only for local development, never on the
# deployed/tunnelled backend.
ENABLE_API_DOCS=false

