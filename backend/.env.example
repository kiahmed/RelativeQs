# Example environment variables for the backend
# Set DATA_PROVIDER to one of: mock, yahoo, alphavantage, twelvedata, polygon, alpaca, finnhub
DATA_PROVIDER=yahoo

# API keys (leave blank to disable an adapter)
ALPHAVANTAGE_KEY=
TWELVEDATA_KEY=
POLYGON_KEY=
ALPACA_KEY=
ALPACA_SECRET=
FINNHUB_KEY=

# Redis (optional) - if set, snapshots will be published to Redis pub/sub and persisted
REDIS_URL=redis://127.0.0.1:6379/0

# If true, the ScoreEngine will compute z-score normalized signals when requested
NORMALIZE_SIGNALS=false

# Logging verbosity: DEBUG, INFO, WARNING, ERROR. Logs go to the console and to
# backend/logs/app.log (rotating). DEBUG is very chatty.
LOG_LEVEL=INFO

# --- Update / refresh rates -------------------------------------------------
# How often the backend re-fetches data and broadcasts it (seconds).
POLL_INTERVAL_SECONDS=30
# How long fetched price history is cached before the provider is called again (seconds).
CACHE_TTL_SECONDS=300

# --- Per-provider rate limits (max API calls per 60 seconds) ----------------
TWELVEDATA_RATE_LIMIT=8
ALPHAVANTAGE_RATE_LIMIT=5
POLYGON_RATE_LIMIT=5
FINNHUB_RATE_LIMIT=30
ALPACA_RATE_LIMIT=5

# --- Supabase Auth ----------------------------------------------------------
# From your Supabase project dashboard -> Settings -> API.
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# Only needed for LEGACY (HS256) projects. Projects using asymmetric JWT
# signing keys are verified via JWKS automatically — leave this as-is then.
SUPABASE_JWT_SECRET=your-supabase-jwt-secret
# Settings -> API -> Project API keys -> service_role (SECRET — server only).
SUPABASE_SERVICE_KEY=your-supabase-service-role-key

# --- Stripe billing ---------------------------------------------------------
# Stripe dashboard -> Developers -> API keys -> Secret key (use a sk_test_ key).
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
# Webhook signing secret. Local dev: run `stripe listen --forward-to
# localhost:8000/api/billing/webhook` and copy the whsec_... it prints.
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_signing_secret
# The recurring Price ID of your "RelativeQs Pro" product (price_...).
STRIPE_PRICE_ID=price_your_pro_price_id
# Frontend base URL Stripe Checkout redirects back to (5173 dev / 4173 preview).
FRONTEND_URL=http://localhost:5173

# --- CORS (production) ------------------------------------------------------
# Comma-separated list of extra allowed origins for the deployed frontend.
# localhost dev origins are always allowed; add the Vercel site here.
# e.g. CORS_ORIGINS=https://relativeqs.vercel.app
CORS_ORIGINS=

# --- Alerts (Resend email) --------------------------------------------------
# API key from resend.com (re_...). If left blank, alerts are logged, not sent.
RESEND_API_KEY=re_your_resend_api_key
# Sender address. Use onboarding@resend.dev for testing, a verified domain live.
ALERT_FROM_EMAIL=RelativeQs <onboarding@resend.dev>

# --- AI-capex dependency index (structural / daily — NOT intraday) ----------
# How much of QQQ's DAILY move is explained by the "AI bottleneck" complex
# (memory, optics/EUV, networking, power, grid). Daily metric, walled off from
# the intraday thesis; cached in-process and refetched every
# AI_DEPENDENCY_REFRESH_SECONDS.
AI_DEPENDENCY_ENABLED=true
AI_DEPENDENCY_TARGET=QQQ
AI_DEPENDENCY_WINDOW=21
AI_DEPENDENCY_CHANGE_LOOKBACK=21
AI_DEPENDENCY_PERIOD=2y
AI_DEPENDENCY_REFRESH_SECONDS=3600
# The basket, grouped by theme. JSON list of {key,label,members:[{symbol,label}]}.
# Members can be pure-play ETFs, dominant bellwether stocks, or standalone names
# with no ETF home yet. Edit freely. Unset/invalid -> config.py _ai_basket() default.
AI_BASKET='[{"key":"memory","label":"Memory","members":[{"symbol":"DRAM","label":"Memory ETF"},{"symbol":"MU","label":"Micron"}]},{"key":"optics","label":"Optics / EUV","members":[{"symbol":"EUV","label":"EUV/optics ETF"},{"symbol":"ASML","label":"ASML"}]},{"key":"networking","label":"Servers / Networking","members":[{"symbol":"TCAI","label":"AI infra ETF"}]},{"key":"power","label":"Power","members":[{"symbol":"AIPO","label":"AI power ETF"},{"symbol":"ZAP","label":"Electrification ETF"}]},{"key":"grid","label":"Grid build-out","members":[{"symbol":"GRID","label":"Smart-grid ETF"}]}]'

# Dev only: ribbon never auto-collapses off-hours (default false)
PREMARKET_FORCE_OPEN=false
