# Deploy-time only — read by deploy/cf-tunnel.sh and by docker compose when it
# interpolates backend/docker-compose.yml. The backend app itself never reads
# this file (its runtime config is backend/.env).
#
# Copy to deploy/.env and fill in. NEVER commit deploy/.env.

# --- Cloudflare -------------------------------------------------------------
# API token used to create / inspect / delete the named tunnel.
# Needs, on the account that owns the zone below:
#   Account -> Cloudflare Tunnel -> Edit
#   Zone    -> DNS               -> Edit   (on RELQS_CF_ZONE)
# Without the Zone:DNS:Edit half, cf-tunnel.sh still creates the tunnel but
# prints the CNAME for you to add by hand.
CF_API_TOKEN=your-cloudflare-api-token
CF_ACCOUNT_ID=your-cloudflare-account-id

# Connector token for the named tunnel. Written automatically by
# `make tunnel-create`; cleared by `make tunnel-delete`. Don't hand-edit.
CF_TUNNEL_TOKEN=
RELQS_TUNNEL_ID=

# --- Tunnel shape -----------------------------------------------------------
# Name of the named tunnel in Cloudflare (Zero Trust -> Networks -> Tunnels).
RELQS_TUNNEL_NAME=relativeq-backend-tunnel
# Permanent public hostname for the backend. Baked into the Vercel bundle at
# build time, so it must not change casually.
RELQS_API_HOST=edge-relativeq.facades.trade
# DNS zone that hostname lives in.
RELQS_CF_ZONE=facades.trade
# Where the connector forwards to, over the compose network (service:port).
RELQS_ORIGIN_SERVICE=http://relativeq-backend:8000
