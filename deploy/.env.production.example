# Frontend production build env for Vercel.
#
# Copy to deploy/.env.production and fill in. deploy_to_cloud.sh copies this to
# ./.env.production before `vercel build`, so Vite inlines these VITE_* values
# into the bundle. (Vite only exposes VITE_-prefixed vars to the browser.)

# Public backend host. https for the API, wss for the websocket feed.
VITE_RELQS_BACKEND_URL=https://api.example.com
VITE_RELQS_WS_URL=wss://api.example.com/ws/market

# Dashboard HTTP re-fetch cadence (ms).
VITE_POLL_INTERVAL_MS=12000

# Supabase (browser-safe anon key only — never the service_role key here).
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-public-key
